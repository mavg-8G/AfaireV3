# Local development: npm run db:local uses this connection.
DATABASE_URL=postgresql://afaire:CHANGE_DB_PASSWORD@127.0.0.1:55432/afaire
AUTH_SECRET=CHANGE_TO_A_RANDOM_SECRET
NEXTAUTH_URL=http://localhost:3000

# Docker Compose builds its DATABASE_URL from these values.
# Use a long hexadecimal password (URL-safe).
POSTGRES_USER=afaire
POSTGRES_DB=afaire
POSTGRES_PASSWORD=CHANGE_DB_PASSWORD

# Production: set NEXTAUTH_URL to your actual HTTPS domain.
REGISTRATION_MODE=invite
REGISTRATION_CODE=CHANGE_INVITATION_CODE

# true ONLY behind Caddy (or a trusted proxy overwriting X-Afaire-Client-IP).
# Keep false for npm run dev / local standalone / direct connections.
TRUST_PROXY=false

# Web Push opcional. Genera una vez con npm run push:keys y conserva las claves.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
