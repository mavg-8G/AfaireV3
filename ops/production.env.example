# Linux VPS: /opt/afaire/.env. Replace all CHANGE_ values before starting.
COMPOSE_FILE=docker-compose.yml:docker-compose.proxy.yml
PROXY_NETWORK=CHANGE_TO_EXISTING_CADDY_NETWORK
POSTGRES_USER=afaire
POSTGRES_DB=afaire
POSTGRES_PASSWORD=CHANGE_TO_RANDOM_HEX_PASSWORD
AUTH_SECRET=CHANGE_TO_RANDOM_64_HEX_SECRET
NEXTAUTH_URL=https://afaire.espectro.uk
DOMAIN=afaire.espectro.uk
REGISTRATION_MODE=invite
REGISTRATION_CODE=CHANGE_TO_RANDOM_INVITATION_CODE
TRUST_PROXY=true
