# Linux VPS: /opt/docker/afaire/.env. Replace all CHANGE_ values before starting.
COMPOSE_FILE=docker-compose.yml:docker-compose.proxy.yml
AFAIRE_IMAGE=ghcr.io/mavg-8g/afairev3
AFAIRE_VERSION=cb5765639cda3e02a7c3b2f4f23e605bd8f227f0
PROXY_NETWORK=proxy
POSTGRES_USER=afaire
POSTGRES_DB=afaire
POSTGRES_PASSWORD=CHANGE_TO_RANDOM_HEX_PASSWORD
AUTH_SECRET=CHANGE_TO_RANDOM_64_HEX_SECRET
NEXTAUTH_URL=https://afaire.espectro.uk
REGISTRATION_MODE=invite
REGISTRATION_CODE=CHANGE_TO_RANDOM_INVITATION_CODE
TRUST_PROXY=true

# Web Push. Genera las claves una vez (npm run push:keys); la privada permanece en el servidor.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://afaire.espectro.uk
