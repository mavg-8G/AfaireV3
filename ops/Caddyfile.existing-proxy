# Añade únicamente este bloque a tu Caddyfile existente.
# Conserva todos los demás sitios y la configuración global.

afaire.espectro.uk {
	# CSP, frame policy and private cache controls come from Afaire itself.
	request_body {
		max_size 1MB
	}
	reverse_proxy afaire-web:3000 {
		# Overwrite any client-supplied value before enabling TRUST_PROXY=true.
		header_up X-Afaire-Client-IP {remote_host}
	}
}
