{
  "name": "afaire",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "node scripts/start.mjs",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "tsx --test tests/integration/*.test.ts",
    "test:web": "tsx scripts/verify-web.ts",
    "pwa:icons": "node scripts/generate-icons.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:dev": "prisma migrate dev",
    "db:local": "tsx scripts/local-db.ts",
    "worker": "tsx scripts/worker.ts",
    "worker:build": "esbuild scripts/worker.ts --bundle --platform=node --external:@prisma/client --format=cjs --minify --outfile=dist/worker.cjs",
    "admin:build": "esbuild scripts/reset-password.ts scripts/generate-push-keys.mjs --bundle --platform=node --external:@prisma/client --format=cjs --minify --outdir=dist/admin --out-extension:.js=.cjs",
    "account:reset": "tsx scripts/reset-password.ts",
    "push:keys": "node scripts/generate-push-keys.mjs",
    "push:setup": "node scripts/setup-push.mjs"
  },
  "dependencies": {
    "@date-fns/tz": "1.5.0",
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.3",
    "date-fns": "4.1.0",
    "dotenv": "17.2.3",
    "next": "16.4.0",
    "next-auth": "4.24.15",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "web-push": "3.6.7",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^20",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "3.6.4",
    "embedded-postgres": "18.4.0-beta.17",
    "esbuild": "0.25.12",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "fast-check": "3.23.2",
    "prisma": "6.19.3",
    "tailwindcss": "^4",
    "tsx": "4.20.6",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2"
  }
}
