{
  "name": "afaire",
  "version": "3.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "node scripts/start.mjs",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "tsx --test tests/integration/*.test.ts",
    "test:web": "tsx scripts/verify-web.ts",
    "pwa:icons": "node scripts/generate-icons.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:dev": "prisma migrate dev",
    "db:local": "tsx scripts/local-db.ts",
    "worker": "tsx scripts/worker.ts",
    "worker:build": "esbuild scripts/worker.ts src/lib/prisma-client.ts --bundle --platform=node --external:@prisma/client --external:@prisma/adapter-pg --external:pg --format=cjs --minify --entry-names=[name] --outdir=dist --out-extension:.js=.cjs",
    "admin:build": "esbuild scripts/reset-password.ts scripts/generate-push-keys.mjs --bundle --platform=node --external:@prisma/client --external:@prisma/adapter-pg --external:pg --format=cjs --minify --outdir=dist/admin --out-extension:.js=.cjs",
    "account:reset": "tsx scripts/reset-password.ts",
    "push:keys": "node scripts/generate-push-keys.mjs",
    "push:setup": "node scripts/setup-push.mjs"
  },
  "dependencies": {
    "@date-fns/tz": "1.5.0",
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/figtree": "5.3.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "bcryptjs": "3.0.3",
    "date-fns": "4.4.0",
    "dotenv": "18.0.7",
    "next": "16.4.0",
    "next-auth": "4.24.15",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "web-push": "3.6.7",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/compat": "2.1.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "3.6.4",
    "@typescript/native": "npm:typescript@7.0.2",
    "embedded-postgres": "18.4.0-beta.17",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "eslint-config-next": "16.4.0",
    "fast-check": "4.10.2",
    "prisma": "7.10.0",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "eslint": "$eslint",
    "mysql2": "3.24.5"
  }
}
