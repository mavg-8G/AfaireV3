{$DOMAIN} {
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        X-Frame-Options DENY
        Strict-Transport-Security "max-age=31536000"
        -Server
    }
    request_body {
        max_size 1MB
    }
    reverse_proxy afaire-web:3000 {
        header_up X-Afaire-Client-IP {remote_host}
    }
}
