generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String   @id @default(cuid())
  email               String   @unique
  passwordHash        String
  name                String
  timezone            String   @default("America/Guayaquil")
  dayStart            String   @default("08:00")
  dayEnd              String   @default("22:00")
  bufferMinutes       Int      @default(10)
  autoPlan            Boolean  @default(false)
  carryOver           Boolean  @default(true)
  adaptiveAvailability Boolean @default(true)
  onboardingCompleted Boolean  @default(false)
  sessionVersion      Int      @default(0)
  createdAt           DateTime @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime @updatedAt @db.Timestamptz(3)
  events              Event[]
  habits              Habit[]
  tasks               Task[]
  dayPlans            DayPlan[]
  availability        Availability[]
  occurrences         HabitOccurrence[]
  usageSamples        UsageSample[]
  series              EventSeries[]
  pushSubscriptions   PushSubscription[]
  notificationSettings NotificationSettings?
  workerRuns          WorkerRun[]
  adaptiveDurations   Boolean @default(false)
  focusWindow         String @default("MORNING")
  slackPercent Int @default(0)
  longBlockMinutes Int @default(90)
  recoveryMinutes Int @default(0)
  dayOverrides DayOverride[]
  taskSeries TaskSeries[]
  templateUses TemplateUse[]
  categoryBudgets CategoryBudget[]
  planRevisions PlanRevision[]
  planFeedback PlanFeedback[]
  dayCheckIns DayCheckIn[]
  deviceSessions DeviceSession[]
  locale String @default("es")
  hourFormat String @default("24")
  weekStartsOn Int @default(1)
}

model Availability {
  id      String  @id @default(cuid())
  userId  String
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekday Int
  active  Boolean @default(true)
  start   String
  end     String
  learnedWindows Json @default("[]")
  learnedActive Boolean?
  learningReason String?
  learnedAt DateTime? @db.Timestamptz(3)
  @@unique([userId, weekday])
}

model Event {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String
  startsAt     DateTime    @db.Timestamptz(3)
  endsAt       DateTime    @db.Timestamptz(3)
  planningDate DateTime?   @db.Date
  locked       Boolean     @default(true)
  source       EventSource @default(MANUAL)
  status       EventStatus @default(PENDING)
  notes        String?
  location     String?
  travelMinutes Int @default(0)
  seriesId     String?
  series       EventSeries? @relation(fields: [seriesId, userId], references: [id, userId], onDelete: NoAction)
  recurrenceDate DateTime? @db.Date
  startedAt    DateTime? @db.Timestamptz(3)
  categoryId String?
  category CategoryBudget? @relation(fields: [categoryId, userId], references: [id, userId], onDelete: NoAction)
  postponedAt DateTime? @db.Timestamptz(3)
  actualMinutes Int?
  estimatedMinutes Int?
  planningReason String?
  recoveryMinutes Int @default(0)
  habitId      String?
  habit        Habit?      @relation(fields: [habitId, userId], references: [id, userId], onDelete: NoAction)
  occurrenceId String?     @unique
  occurrence   HabitOccurrence? @relation(fields: [occurrenceId, userId], references: [id, userId], onDelete: NoAction)
  taskId       String?
  task         Task?       @relation(fields: [taskId, userId], references: [id, userId], onDelete: NoAction)
  createdAt    DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime    @updatedAt @db.Timestamptz(3)
  @@index([userId, startsAt])
  @@index([userId, status])
  @@index([userId, planningDate])
  @@unique([occurrenceId, userId])
  @@unique([seriesId, recurrenceDate])
}

model Habit {
  categoryId String?
  category CategoryBudget? @relation(fields: [categoryId, userId], references: [id, userId], onDelete: NoAction)
  id              String          @id @default(cuid())
  userId          String
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String
  durationMinutes Int
  priority        Int             @default(2)
  required        Boolean         @default(false)
  preferredWindow PreferredWindow @default(ANY)
  daysOfWeek      Int[]
  frequencyMode String @default("DAYS")
  weeklyTarget Int @default(3)
  active          Boolean         @default(true)
  archived        Boolean         @default(false)
  createdAt       DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @db.Timestamptz(3)
  events          Event[]
  occurrences     HabitOccurrence[]
  @@unique([id, userId])
  @@index([userId, active])
}

model HabitOccurrence {
  id      String      @id @default(cuid())
  userId  String
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  habitId String
  habit   Habit       @relation(fields: [habitId, userId], references: [id, userId], onDelete: NoAction)
  date    DateTime    @db.Date
  status  EventStatus @default(PENDING)
  event   Event?
  @@unique([habitId, date])
  @@unique([id, userId])
  @@index([userId, date])
}

model Task {
  categoryId String?
  category CategoryBudget? @relation(fields: [categoryId, userId], references: [id, userId], onDelete: NoAction)
  postponements Int @default(0)
  handledPostponements Int @default(0)
  delegatedTo String?
  id              String          @id @default(cuid())
  userId          String
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String
  durationMinutes Int             @default(30)
  dueDate         DateTime?       @db.Date
  status          TaskStatus      @default(INBOX)
  priority        Int             @default(2)
  preferredWindow PreferredWindow @default(ANY)
  archived        Boolean         @default(false)
  energy          String          @default("LIGHT")
  availableFrom DateTime? @db.Date
  seriesId String?
  series TaskSeries? @relation(fields: [seriesId, userId], references: [id, userId], onDelete: NoAction)
  periodStart DateTime? @db.Date
  createdAt       DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @db.Timestamptz(3)
  events          Event[]
  @@unique([id, userId])
  @@index([userId, status])
  @@unique([seriesId, periodStart])
}

model DayPlan {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date        DateTime @db.Date
  generatedAt DateTime @default(now()) @db.Timestamptz(3)
  version     Int      @default(1)
  skipped     String[] @default([])
  details     Json     @default("[]")
  @@unique([userId, date])
}

model AccessAttempt {
  key       String   @id
  count     Int      @default(1)
  expiresAt DateTime @db.Timestamptz(3)
}

model WorkerHeartbeat {
  id        String   @id @default("daily-planner")
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

model EventSeries {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  title String
  notes String?
  location String?
  travelMinutes Int @default(0)
  timezone String
  frequency String
  weekdays Int[]
  startDate DateTime @db.Date
  until DateTime @db.Date
  startTime String
  endTime String
  endDayOffset Int @default(0)
  events Event[]
  @@unique([id, userId])
}

model NotificationSettings {
  userId String @id
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  upcoming Boolean @default(true)
  leadMinutes Int @default(10)
  dailySummary Boolean @default(true)
  summaryTime String @default("08:00")
  dueTomorrow Boolean @default(true)
  dueTime String @default("18:00")
  quietEnabled Boolean @default(false)
  quietStart String @default("22:00")
  quietEnd String @default("08:00")
}

model PushSubscription {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint String @unique
  p256dh String
  auth String
  sessionVersion Int
  deliveries PushDelivery[]
  deviceSessionId String?
  deviceSession DeviceSession? @relation(fields: [deviceSessionId, userId], references: [id, userId], onDelete: NoAction)
}

model PushDelivery {
  id String @id @default(cuid())
  subscriptionId String
  subscription PushSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  key String
  sentAt DateTime? @db.Timestamptz(3)
  attemptedAt DateTime @default(now()) @db.Timestamptz(3)
  attempts Int @default(0)
  error String?
  @@unique([subscriptionId, key])
}

model WorkerRun {
  kind String @default("PLAN")
  retryAt DateTime? @db.Timestamptz(3)
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  date DateTime @db.Date
  status String
  message String?
  attemptedAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([userId, attemptedAt])
}

model UsageSample {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  date DateTime @db.Date
  weekday Int
  minute Int
  timezone String
  observedAt DateTime @default(now()) @db.Timestamptz(3)
  @@unique([userId, date, minute, timezone])
  @@index([userId, observedAt])
}

enum EventSource {
  MANUAL
  AUTO
  HABIT
}
enum EventStatus {
  PENDING
  IN_PROGRESS
  DONE
  SKIPPED
  CANCELLED
}
enum TaskStatus {
  INBOX
  SCHEDULED
  DONE
  CANCELLED
}
enum PreferredWindow {
  MORNING
  AFTERNOON
  EVENING
  ANY
}

model DayOverride {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  date DateTime @db.Date
  label String?
  paused Boolean @default(false)
  startTime String?
  endTime String?
  capacityPercent Int @default(100)
  essentialOnly Boolean @default(false)
  @@unique([userId, date])
}

model TaskSeries {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  title String
  durationMinutes Int
  priority Int @default(2)
  preferredWindow PreferredWindow @default(ANY)
  energy String @default("LIGHT")
  frequency String
  anchorDate DateTime @db.Date
  windowDays Int @default(7)
  active Boolean @default(true)
  tasks Task[]
  @@unique([id, userId])
}

model TemplateUse {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  key String
  date DateTime @db.Date
  @@unique([userId, key, date])
}

model DeviceSession {
  id String @id
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  label String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  lastSeenAt DateTime @default(now()) @db.Timestamptz(3)
  expiresAt DateTime @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  subscriptions PushSubscription[]
  @@unique([id, userId])
  @@index([userId, expiresAt])
}

model CategoryBudget {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  name String
  weeklyMinutes Int
  preferredWindow PreferredWindow @default(ANY)
  active Boolean @default(true)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  tasks Task[]
  habits Habit[]
  events Event[]
  @@unique([id, userId])
  @@unique([userId, name])
}
model PlanRevision {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  date DateTime @db.Date
  kind String
  before Json
  after Json
  undoneAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([userId, date, createdAt])
}
model PlanFeedback {
  source String @default("EXPLICIT")
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  date DateTime @db.Date
  reason String
  preferredWindow PreferredWindow?
  taskId String?
  habitId String?
  suggestedMinutes Int?
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  @@unique([userId, date, reason])
}
model DayCheckIn {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  date DateTime @db.Date
  mood String
  note String?
  resolved Int @default(0)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  @@unique([userId, date])
}
